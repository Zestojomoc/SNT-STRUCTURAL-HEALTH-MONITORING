{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "api/**",
      "excludeFiles": "{tests/**,artifacts/**,.next/**,.next-dev/**}"
    }
  },
  "routes": [
    {
      "src": "/api/runtime-health",
      "dest": "/api/runtime_health"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api"
    }
  ]
}
