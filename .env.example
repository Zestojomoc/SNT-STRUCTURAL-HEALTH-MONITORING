# Safe default for local development. Synthetic readings are always labeled.
SHM_DEMO_MODE=false
SHM_DEMO_FAIL=false
SHM_STRUCTURE_NAME=Monitored Structure
DEFAULT_MONITOR_INTERVAL_SECONDS=5
# `npm run dev` sets this local proxy automatically. Do not configure it in
# Vercel; production uses native same-origin /api routing.
# SHM_LOCAL_API_URL=http://127.0.0.1:8000

# Required when SHM_DEMO_MODE=false. Site-specific values were not present in
# the supplied workspace, so deliberately fill these from the actual project.
RASPBERRY_SHAKE_BASE_URL=https://data.raspberryshake.org
RASPBERRY_SHAKE_NETWORK=AM
RASPBERRY_SHAKE_STATION=RA909
RASPBERRY_SHAKE_LOCATION=00
RASPBERRY_SHAKE_CHANNELS=ENE,ENN,ENZ
RASPBERRY_SHAKE_MODEL=Raspberry Shake 4D
RASPBERRY_SHAKE_SITE=Philippines
RASPBERRY_SHAKE_WAVEFORM_DURATION_SECONDS=30
# Public Raspberry Shake FDSN data is delayed. Use 1800 for the public archive,
# or 0 only for an endpoint that is actually authorized for real-time data.
RASPBERRY_SHAKE_DATA_DELAY_SECONDS=2100
RASPBERRY_SHAKE_TIMEOUT_SECONDS=12

# Optional for live acquisition, but required for baseline comparison, estimated
# stiffness change, and structural condition status. These must be validated for
# the monitored structure; never derive them from a single waveform.
SHM_BASELINE_FREQUENCY_HZ=
SHM_ATTENTION_FREQUENCY_CHANGE_PERCENT=
SHM_WARNING_FREQUENCY_CHANGE_PERCENT=

# Processing band, in Hz. Confirm against the structure and sensor installation.
SHM_FILTER_LOW_HZ=0.2
SHM_FILTER_HIGH_HZ=20
SHM_FREQUENCY_SEARCH_LOW_HZ=0.5
SHM_FREQUENCY_SEARCH_HIGH_HZ=20
SHM_WAVEFORM_POINTS=180
